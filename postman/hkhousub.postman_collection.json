        {
          "name": "8) 청약 - 김철수(70)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.test('score 스냅샷 70', () => pm.expect(pm.response.json().score).to.eql(70));"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"apartment\": \"{{apartment_id}}\",\n  \"member\": \"{{member_1}}\"\n}" },
            "url": { "raw": "{{base_url}}/applications/", "host": ["{{base_url}}"], "path": ["applications", ""] }
          }
        },
