          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"apartment\": \"{{apartment_id}}\",\n  \"member\": \"{{member_3}}\"\n}" },
            "url": { "raw": "{{base_url}}/applications/", "host": ["{{base_url}}"], "path": ["applications", ""] }
          }
        },
        {
          "name": "11) 청약 - 최지우(55, 낙첨)",
          "event": [
