          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"apartment\": \"{{apartment_id}}\",\n  \"member\": \"{{member_4}}\"\n}" },
            "url": { "raw": "{{base_url}}/applications/", "host": ["{{base_url}}"], "path": ["applications", ""] }
          }
        },
        {
          "name": "12) 청약 - 김철수 중복 (400 기대)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('중복 청약은 400', () => pm.response.to.have.status(400));"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"apartment\": \"{{apartment_id}}\",\n  \"member\": \"{{member_1}}\"\n}" },
            "url": { "raw": "{{base_url}}/applications/", "host": ["{{base_url}}"], "path": ["applications", ""] }
          }
        },
        {
          "name": "13) 커트라인 조회 (=62 검증)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('상태 마감', () => pm.expect(j.status).to.eql('마감'));",
                  "pm.test('커트라인 62', () => pm.expect(j.cutline_score).to.eql(62));",
                  "pm.test('지원자 4명', () => pm.expect(j.application_count).to.eql(4));",
                  "pm.test('경쟁률 1.33', () => pm.expect(j.competition_rate).to.eql(1.33));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/apartments/{{apartment_id}}/cutline/", "host": ["{{base_url}}"], "path": ["apartments", "{{apartment_id}}", "cutline", ""] }
          }
        }
      ]
    },
    {
