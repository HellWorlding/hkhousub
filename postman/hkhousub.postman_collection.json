                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"complex\": \"{{complex_id}}\",\n  \"name\": \"84A\",\n  \"area\": 84.97,\n  \"supply_count\": 3,\n  \"price\": 1200000000\n}" },
            "url": { "raw": "{{base_url}}/apartments/", "host": ["{{base_url}}"], "path": ["apartments", ""] }
          }
        },
